{
  "name": "chrome-extension-upload",
  "version": "7.0.0",
  "private": true,
  "description": "upload & publish extensions to the Chrome Web Store",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts",
    "pack": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js",
    "test": "jest",
    "all": "npm run build && npm run format && npm run lint && npm run pack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnao305/chrome-extension-upload.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "mnao305",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "chrome-webstore-upload": "^6.0.0",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.130",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.2.0",
    "eslint-plugin-github": "^4.3.3",
    "eslint-plugin-jest": "^27.9.0",
    "jest": "^29.7.0",
    "js-yaml": "^3.13.1",
    "prettier": "^1.19.1",
    "ts-jest": "^29.4.12",
    "typescript": "^4.9.5"
  }
}
